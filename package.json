    "@types/leaflet": "^1.9.18",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
