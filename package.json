{
  "name": "bobil-tur-sommer-26",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive map of a 5-day motorhome trip in south-eastern Norway, July 2026",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
